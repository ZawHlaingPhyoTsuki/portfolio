{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "nextjs", "typescript", "import", "jsx-a11y", "unicorn"],
  "jsPlugins": ["@shadcn/lint"],
  "ignorePatterns": [
    "src/components/ui/**",
    ".next/**",
    "node_modules/**",
    ".agents/**"
  ],
  "categories": {
    "correctness": "error"
  },
  "settings": {
    "react": {
      "version": "19.2"
    },
    "next": {
      "rootDir": "."
    }
  },
  "rules": {
    "nextjs/no-html-link-for-pages": "warn",
    "nextjs/next-script-for-ga": "error",
    "shadcn/no-arbitrary-values": "error"
  }
}
